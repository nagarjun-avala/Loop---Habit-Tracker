# How the browser reaches the API. Pick ONE of the two options.

# Option A: call the API directly. Needs both hosts on the same site (app.example.com + api.example.com),
# or local development (localhost + localhost). Set before building.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Option B: the API is on a DIFFERENT domain (e.g. two separate *.vercel.app projects). Forward API calls through this app
# so the sign-in cookie belongs to this site. Use this INSTEAD of Option A (comment A out). Set before building.
# API_ORIGIN=https://your-api.example.com
