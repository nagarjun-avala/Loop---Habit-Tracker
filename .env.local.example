# Where your API lives. That is the only thing to set for a deployed app.
#
# Local development: the app calls it directly.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production (Vercel, Netlify, any Node host): use the API's public address. Production builds route API calls THROUGH this
# app automatically, so the sign-in cookie works on phones too. Set before building:
# NEXT_PUBLIC_API_URL=https://your-api.example.com/api/v1
# (API_ORIGIN=https://your-api.example.com does the same thing.)
#
# Only if the app and API share one parent domain (app.example.com + api.example.com) and you want the browser to call the API
# directly, add:
# API_MODE=direct
